# ============================================================================
# ProductGuard Production Environment Configuration Template
# Duplicate this file to .env.production and configure production credentials
# ============================================================================

# Security & App Configuration
FLASK_CONFIG=production
FLASK_APP=run.py
SECRET_KEY=generate_a_cryptographically_secure_random_hex_key_here

# PostgreSQL Database Connection
POSTGRES_USER=productguard_admin
POSTGRES_PASSWORD=Use_A_Strong_Database_Password_Here!2026
POSTGRES_DB=productguard_db
DATABASE_URL=postgresql://productguard_admin:Use_A_Strong_Database_Password_Here!2026@localhost:5432/productguard_db

# File Storage & Rate Limiting
UPLOAD_FOLDER=/app/app/static/uploads
MAX_CONTENT_LENGTH=5242880
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URI=memory://

# AI Model Cosine Similarity Thresholds
MODEL_NAME=MobileNetV2
SIMILARITY_THRESHOLD_HIGH=0.82
SIMILARITY_THRESHOLD_MODERATE=0.65
SIMILARITY_THRESHOLD_MINIMUM=0.40

# Gunicorn WSGI Concurrency Settings
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
