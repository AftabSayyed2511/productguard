# Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-0987654321fedcba

# Database Configuration
# Local development uses SQLite by default; use PostgreSQL in production
DATABASE_URL=sqlite:///productguard.db

# File Upload Configuration
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=5242880 # 5 MB in bytes

# AI Model Configuration
MODEL_NAME=MobileNetV2
SIMILARITY_THRESHOLD_HIGH=0.82
SIMILARITY_THRESHOLD_MODERATE=0.65
SIMILARITY_THRESHOLD_MINIMUM=0.40
